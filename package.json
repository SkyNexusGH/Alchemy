{
  "name": "ovyra",
  "productName": "Alchemy",
  "version": "0.1.10",
  "description": "A fast, private, colorful browser.",
  "author": "SkyNexusHD (SNHD) and FiveNova",
  "homepage": "https://github.com/SkyNexusGH/Alchemy",
  "repository": {
    "type": "git",
    "url": "https://github.com/SkyNexusGH/Alchemy.git"
  },
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "npm version patch -m \"Release %s\" && git push --follow-tags"
  },
  "build": {
    "appId": "com.ovyra.browser",
    "productName": "Alchemy",
    "copyright": "Copyright © 2026 SkyNexusHD (SNHD) and FiveNova",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "!resources/installer.nsh",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "differentialPackage": true,
      "artifactName": "Alchemy-Setup-${version}.${ext}",
      "shortcutName": "Alchemy",
      "deleteAppDataOnUninstall": false,
      "include": "resources/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SkyNexusGH",
        "repo": "Alchemy",
        "releaseType": "release"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "extraResources": [
      {
        "from": "build-tor",
        "to": "tor",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.11",
    "tldts-experimental": "^7.4.19"
  },
  "license": "GPL-3.0-or-later"
}
